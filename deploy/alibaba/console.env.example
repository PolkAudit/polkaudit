# /etc/polkaudit/console.env — runtime for apps/console (admin UI)
# NEXT_PUBLIC_* baked at build time in GitHub Actions; keep matching values for SSR.
PORT=3001
HOSTNAME=127.0.0.1
NEXT_PUBLIC_API_URL=https://api.polkaudit.xyz/api/v1
NEXT_PUBLIC_APP_URL=https://app.polkaudit.xyz
# Same-box SSR → local API (governance KPIs)
INTERNAL_API_URL=http://127.0.0.1:8080/api/v1
API_KEY=CHANGE_ME_SAME_AS_BACKEND
NEXT_PUBLIC_API_KEY=CHANGE_ME_SAME_AS_BACKEND
