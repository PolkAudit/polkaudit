# /etc/polkaudit/backend.env — never commit real secrets
DATABASE_URL=postgresql+asyncpg://polkaudit:CHANGE_ME@127.0.0.1:5432/polkaudit
API_KEY=CHANGE_ME_LONG_RANDOM
# Dedicated JWT signing secret (recommended; falls back to API_KEY if unset)
SECRET_KEY=CHANGE_ME_JWT_SECRET
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8080

# Public URLs (magic links + Razorpay callback → console SaaS UI on Vercel)
APP_PUBLIC_URL=https://console.polkaudit.xyz
API_PUBLIC_URL=https://api.polkaudit.xyz

# Optional SMTP — if unset, verify/reset links are logged to journalctl
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=PolkAudit <noreply@polkaudit.xyz>
# SMTP_USE_TLS=true

# Optional Razorpay Payment Links — if unset, checkout returns manual contact mode
# RAZORPAY_KEY_ID=rzp_live_xxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
