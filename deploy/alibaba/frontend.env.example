# /etc/polkaudit/frontend.env — runtime for apps/frontend (dashboard)
# NEXT_PUBLIC_* baked at build time in GitHub Actions; keep matching values here for SSR.
PORT=3000
HOSTNAME=127.0.0.1
NEXT_PUBLIC_API_URL=https://api.polkaudit.xyz/api/v1
API_KEY=CHANGE_ME_SAME_AS_BACKEND
NEXT_PUBLIC_API_KEY=CHANGE_ME_SAME_AS_BACKEND
# Same-box SSR must hit local API (DNS/public hostname often not ready yet)
INTERNAL_API_URL=http://127.0.0.1:8080/api/v1
# Account console (same SAS) — used for redirects from dashboard
NEXT_PUBLIC_CONSOLE_URL=https://console.polkaudit.xyz
