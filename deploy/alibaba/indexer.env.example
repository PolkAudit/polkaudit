# /etc/polkaudit/indexer.env — never commit real secrets
DATABASE_URL=postgresql+asyncpg://polkaudit:CHANGE_ME@127.0.0.1:5432/polkaudit
SUBSTRATE_RPC_URL=wss://rpc.polkadot.io
LOG_LEVEL=INFO
RETRY_DELAY_SECONDS=2
# Tip-relative window for free/cheap disks — set after truncate / first boot
INDEXER_START_BLOCK=0
INDEXER_CATCHUP_WINDOW=500
